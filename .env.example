# QA Accessibility - Variaveis de ambiente
# Copie este arquivo para .env e preencha os valores

# ── Camada WORKER (classificadores single-shot) ──────────────────────────────
# Engine agentica propria do projeto (run_agent.AIAgent). Providers suportados
# (escolha um): openai | gemini | anthropic | xai | ollama-cloud
# LLM_MODEL=alto -> resolve o melhor modelo recente e com suporte a
# ferramentas do provider (catalogo local em agent/models_dev.py). Deixe
# LLM_PROVIDER vazio para obrigar a configuracao pela tela de Configuracoes.
LLM_PROVIDER=
LLM_API_KEY=your_api_key_here
LLM_MODEL=alto
# LLM_BASE_URL=          # opcional — override avancado do endpoint do provider

# ── Camada CHAT agentico (tool-loop multi-turn) ──────────────────────────────
# Mesmos providers (todos suportam o round-trip multi-turn de tools).
# Os modelos disponiveis sao listados ao vivo em GET /models.
# Se nao preenchido, cai no LLM_* acima.
# CHAT_LLM_PROVIDER=anthropic
# CHAT_LLM_MODEL=alto
# CHAT_LLM_API_KEY=your_chat_provider_key_here
# CHAT_LLM_BASE_URL=

# Failover opcional — provider de reserva acionado pelo AIAgent quando o primario falha.
# Inerte se nao preenchido (comportamento sem failover). Evita que uma falha do
# provider primario derrube todos os sub-agentes de uma vez.
# Use um provider diferente do primario (ex.: primario openai, reserva anthropic).
# LLM_FALLBACK_PROVIDER=anthropic
# LLM_FALLBACK_MODEL=alto
# LLM_FALLBACK_API_KEY=your_fallback_api_key_here
# LLM_FALLBACK_BASE_URL=

# ── Busca web (chat) ──────────────────────────────────────────────────────────
# TAVILY_API_KEY=your_tavily_key_here
# EXA_API_KEY=your_exa_key_here

# ── Crawl / rendering na nuvem (opcional) ────────────────────────────────────
# FIRECRAWL_API_KEY=your_firecrawl_key_here
# BROWSERLESS_WS_URL=wss://your-browserless-endpoint

# ── Pipeline de sub-agentes ───────────────────────────────────────────────────
# A11Y_MAX_CONCURRENT_AGENTS=3
# AGENT_TIMEOUT_SECONDS=180

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
DEBUG=false

# CORS - origens permitidas (separadas por virgula)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001","http://localhost:8081","http://127.0.0.1:8081"]

# Seguranca
SECRET_KEY=your_secret_key_here

# Upload de arquivos
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
